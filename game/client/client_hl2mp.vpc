//-----------------------------------------------------------------------------
//	CLIENT_HL2MP.VPC
//
//	Project Script
//-----------------------------------------------------------------------------

$Macro SRCDIR		"..\.."
$Macro GAMENAME 	"hl2mp" [!$SOURCESDK]
$Macro GAMENAME 	"mod_hl2mp" [$SOURCESDK]

$Include "$SRCDIR\game\client\client_base.vpc"

$Configuration
{
	$Compiler
	{
		$AdditionalIncludeDirectories		"$BASE;.\fof;$SRCDIR\game\shared\fof;.\hl2mp\ui;.\hl2mp;$SRCDIR\game\shared\hl2mp;.\hl2;.\hl2\elements;$SRCDIR\game\shared\hl2"
		$PreprocessorDefinitions			"$BASE;HL2MP;HL2_CLIENT_DLL;GLOWS_ENABLE"
		$DisableSpecificWarnings			"$BASE;4456;4457;4458;4459;4463;4838;5205"
	}
}

